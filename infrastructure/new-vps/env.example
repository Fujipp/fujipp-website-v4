# Images, usually GHCR tags pinned by commit SHA from the "Build New VPS Images"
# workflow. Avoid :latest for branch smoke tests.
BACKEND_IMAGE=ghcr.io/fujipp/fujipp-backend:CHANGE_ME
BILLING_IMAGE=ghcr.io/fujipp/fujipp-billing:CHANGE_ME
VOUCHER_IMAGE=ghcr.io/fujipp/fujipp-voucher:CHANGE_ME
RUNTIME_IMAGE=ghcr.io/fujipp/fujipp-runtime:CHANGE_ME

# Supabase Postgres transaction pooler.
# Required: sslmode=require and prepareThreshold=0.
DB_URL=jdbc:postgresql://CHANGE_ME.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Keep pooler usage modest on the new VPS.
BACKEND_DB_POOL_MAX_SIZE=4
BILLING_DB_POOL_MAX_SIZE=3
VOUCHER_DB_POOL_MAX_SIZE=2

# Supabase Auth.
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_JWT_SECRET=CHANGE_ME

# Public/API CORS. Keep this narrow during bring-up.
CORS_ALLOWED_ORIGINS=https://fujipp.com
CORS_ALLOWED_ORIGIN_PATTERNS=https://fujipp.com

# Internal service tokens.
BILLING_SERVICE_TOKEN=CHANGE_ME_STRONG_RANDOM
RUNTIME_SERVICE_TOKEN=CHANGE_ME_STRONG_RANDOM
VOUCHER_SERVICE_TOKEN=CHANGE_ME_STRONG_RANDOM

# Shared AES key for bot/customer secrets. Must match backend, billing, and runtime.
BOT_SECRET_KEY=CHANGE_ME_32_BYTES_BASE64_OR_64_HEX

# Runtime bring-up safety.
RUNTIME_AUTOMATION_ENABLED=false
RESUME_ON_BOOT=false
RESUME_STAGGER_MS=2500
RUNTIME_NODE_ID=
RUNTIME_NODE_OPTIONS=--max-old-space-size=128
DB_SSL_NO_VERIFY=true
VOUCHER_BASE_URL=http://voucher:8082

# SlipOK and PromptPay.
SLIPOK_BASE_URL=https://api.slipok.com
SLIPOK_BRANCH_ID=CHANGE_ME
SLIPOK_API_KEY=CHANGE_ME
PROMPTPAY_ID=CHANGE_ME

# Voucher service.
VOUCHER_SERVER_PORT=8082
VOUCHER_CLIENT_CHECK_ENABLED=true
VOUCHER_ALLOWED_CLIENT_IDS=
TW_USER_AGENT=tmn-redeemer/1.0
TW_TIMEOUT_MS=12000
VOUCHER_ADAPTER=truewallet

# Monitoring. Keep external frontend probing explicit during bring-up.
APP_VERSION=0.1.0-new-vps
MONITORING_COLLECT_ENABLED=true
MONITORING_FRONTEND_PROBE_URL=
