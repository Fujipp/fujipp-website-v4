# Copy to .env and fill in. The anon key is a publishable client key (it ends up
# in the built JS), but keep this file as placeholders only.

# Supabase (Settings > API) — same values for local and hosted
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# Backend API base URL — pick which backend the app talks to:
#   bun run dev        -> http://localhost:8080   (local backend; value below)
#   bun run dev:host   -> https://api.fujipp.com  (hosted backend; set by the script)
#   production build   -> https://api.fujipp.com  (CI injects it from the FRONTEND_ENV_FILE secret)
VITE_API_BASE_URL=http://localhost:8080
