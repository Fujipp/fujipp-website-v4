# Copy to .env and fill in. The anon key is a publishable client key (it ends up
# in the built JS), but keep this file as placeholders only.

# Supabase (Settings > API) — same values for local and hosted
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>

# Backend API — pick which backend the app talks to by flipping VITE_API_TARGET,
# or use the explicit scripts without editing this file:
#   bun run dev:local       -> VITE_API_LOCAL_URL
#   bun run dev:host        -> VITE_API_HOST_URL through the Vite /host-api proxy
#   VITE_API_TARGET=local   -> VITE_API_LOCAL_URL   (default; also `bun run dev`)
#   VITE_API_TARGET=host    -> VITE_API_HOST_URL
# VITE_API_BASE_URL is an optional hard override that wins over the toggle
# (production build: CI injects it from the FRONTEND_ENV_FILE secret).
VITE_API_TARGET=local
VITE_API_LOCAL_URL=http://localhost:8080
VITE_API_HOST_URL=https://api.fujipp.com
# VITE_API_BASE_URL=
