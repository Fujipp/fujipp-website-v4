# Database — same Supabase project as the platform backend.
# Tables live in the `billing` schema (default_schema set in application.properties).
DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=600000

# Port (separate from the main backend)
BILLING_SERVER_PORT=8081

# Shared secret the main backend must send in X-Service-Token on every request.
# Generate one with: openssl rand -hex 32
BILLING_SERVICE_TOKEN=<generate-a-strong-random-secret>

# AES-256-GCM key for encrypting feature config secrets.
# MUST be the SAME value as the main backend and orchestrator (32 bytes; openssl rand -hex 32).
BOT_SECRET_KEY=<same-as-backend-and-orchestrator>
