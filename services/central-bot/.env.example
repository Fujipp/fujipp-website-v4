# ─────────────────────────────────────────────────────────────────────────────
# central-bot env contract
#
# The orchestrator (bot-runtime-service) builds this env per subject at start:
#   - decrypts the Discord token + per-feature secrets (AES-256-GCM)
#   - sets ENABLED_FEATURES from that bot's ACTIVE billing subscriptions
#   - injects each feature's config_values using the SAME keys as the seeded
#     billing.feature_variable_templates (variable_key == env name)
#
# For local dev, copy to .env and fill in. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── runtime / identity ───────────────────────────────────────────────────────
PORT=8080
BOT_SUBJECT_ID=
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Discord user ids allowed to run admin commands (comma-separated)
AUTHORIZED_USER_IDS=

# Comma-separated feature codes that are ACTIVE for this bot
ENABLED_FEATURES=roblox-robux-payout,wallet-topup

# Shop wallet DB (the `shop` schema in Supabase) — used by the wallet-topup feature.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
DB_SSL_NO_VERIFY=true

# ── feature: roblox-robux-payout ─────────────────────────────────────────────
# (keys mirror billing.feature_variable_templates for this feature)
ROBLOX_GROUP_ID=
ROBLOX_SECURITY_COOKIE=
ROBLOX_TOTP_SECRET=
ROBLOX_GROUP_NAME=
ROBUX_RATE=
ROBUX_ENABLED=true
ROBUX_PAYOUT_COOLDOWN=0
ROBUX_NOTIFY_CHANNEL=
PAYMENT_COUNTDOWN_ENABLED=false
PAYMENT_COUNTDOWN_TARGET=
# advanced multi-group (JSON array); overrides the single-group keys above
ROBLOX_GROUPS=

# ── feature: voice-keeper ────────────────────────────────────────────────────
# Keep the bot in a voice channel 24/7. Set the channel + enable to auto-join on
# startup; admins can also drive it live with /join [channel] and /leave.
VOICE_CHANNEL_ID=
VOICE_KEEP_ENABLED=false
