{
  "name": "central-bot",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "One configurable Discord bot codebase. The orchestrator runs one process per customer bot (subject), injecting that subject's token, config, and enabled features via env.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "axios": "^1.7.3",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "libsodium-wrappers": "^0.8.4",
    "otplib": "^12.0.1",
    "pg": "^8.12.0"
  }
}
