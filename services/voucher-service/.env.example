# Database — same Supabase project as the platform backend.
# Tables live in the `voucher` schema (default_schema set in application.properties).
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Port (separate from the main backend 8080 and billing 8081)
VOUCHER_SERVER_PORT=8082

# Shared secret callers must send in the x-api-key header on every request.
# Generate one with: openssl rand -hex 32
VOUCHER_SERVICE_TOKEN=<generate-a-strong-random-secret>

# Lock redeem to bots we run on the platform. When true (default), the X-Client-Id must
# be a real bots.bot_instances subject id — so every shop that buys the top-up feature
# works automatically, and an outside caller (even with the token) is rejected. Set false
# only for local/dev runs that have no bot rows.
VOUCHER_CLIENT_CHECK_ENABLED=true

# Optional: extra always-allow X-Client-Id values (comma-separated) for non-bot internal
# callers. Additive to the platform check above — usually leave empty.
# VOUCHER_ALLOWED_CLIENT_IDS=

# TrueMoney upstream tuning
TW_USER_AGENT=tmn-redeemer/1.0
TW_TIMEOUT_MS=12000
