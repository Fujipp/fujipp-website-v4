# Database — same Supabase project as the platform backend.
# Tables live in the `voucher` schema (default_schema set in application.properties).
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<database-password>

# Port (separate from the main backend 8080 and billing 8081)
VOUCHER_SERVER_PORT=8082

# Shared secret callers must send in the x-api-key header on every request.
# Generate one with: openssl rand -hex 32
VOUCHER_SERVICE_TOKEN=<generate-a-strong-random-secret>

# Optional: lock the service to your own network. Comma-separated allowlist of
# X-Client-Id values; when set, only these clients may redeem (a missing/unknown id
# is rejected). central-bot shops send their subject id; the legacy PM2 bot sends
# kanom-001 — include every id you want to allow. Leave empty to accept any valid token.
# VOUCHER_ALLOWED_CLIENT_IDS=kanom-001,<your-shop-subject-id>

# TrueMoney upstream tuning
TW_USER_AGENT=tmn-redeemer/1.0
TW_TIMEOUT_MS=12000
