# ─────────────────────────────────────────────────────────────────────────────
# bot-runtime-service (orchestrator) env
# Internal service — never exposed publicly. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8090

# Supabase Postgres connection (service_role / direct). Reads bots.* and billing.*.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
# set to "true" to disable TLS verification (Supabase uses a managed cert)
DB_SSL_NO_VERIFY=true

# AES-256-GCM key used to decrypt Discord tokens + per-feature secrets.
# 32 bytes, as 64-char hex OR base64. MUST match what wrote the ciphertext.
BOT_SECRET_KEY=

# Absolute path to the central-bot entrypoint this orchestrator launches.
CENTRAL_BOT_ENTRY=../central-bot/src/server.js

# Shared secret callers must send as X-Service-Token (backend → orchestrator).
SERVICE_TOKEN=
