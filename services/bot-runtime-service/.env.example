# ─────────────────────────────────────────────────────────────────────────────
# bot-runtime-service (orchestrator) env
# Internal service — never exposed publicly. NEVER commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

PORT=8090

# Supabase Postgres connection. Reads bots.* and billing.*, and is forwarded to
# every launched bot as its shop-wallet DATABASE_URL (one shared DB, scoped per bot).
#
# Prod with many bots: use the TRANSACTION pooler (Dashboard → Connect → Transaction)
# so each bot's pool (max 3 conns) is multiplexed instead of holding direct
# connections — this is what keeps us under Supabase's connection ceiling at scale.
#   postgresql://postgres.<project-ref>:PASSWORD@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Our wallet code uses only parameterized + BEGIN/COMMIT queries (no named prepared
# statements), so transaction mode is safe. Direct/session pooler (port 5432) also
# works but burns a real connection per bot.
DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# set to "true" to disable TLS verification (Supabase uses a managed cert)
DB_SSL_NO_VERIFY=true
DB_POOL_MAX_SIZE=3
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# AES-256-GCM key used to decrypt Discord tokens + per-feature secrets.
# 32 bytes, as 64-char hex OR base64. MUST match what wrote the ciphertext.
BOT_SECRET_KEY=

# Absolute path to the central-bot entrypoint this orchestrator launches.
CENTRAL_BOT_ENTRY=../central-bot/src/server.js

# Shared secret callers must send as X-Service-Token (backend → orchestrator).
SERVICE_TOKEN=

# ── Resume-on-boot ───────────────────────────────────────────────────────────
# On startup the orchestrator re-starts the bots the DB still marks RUNNING, so a
# deploy (which recreates this container and kills every bot) doesn't leave them
# down until started by hand.
#   RESUME_ON_BOOT=false   → disable the auto-resume entirely.
#   RUNTIME_NODE_ID=<uuid> → only resume bots placed on this VPS node. REQUIRED when
#                            more than one orchestrator runs, or two would both try to
#                            start the same bot. Leave unset for a single orchestrator
#                            host (resumes every RUNNING bot).
#   RESUME_STAGGER_MS=1500 → delay between each bot start (avoid a login/CPU spike).
RESUME_ON_BOOT=true
# RUNTIME_NODE_ID=
RESUME_STAGGER_MS=1500

# Default voucher-service endpoint injected into every bot this node launches, used when
# the shop leaves TRUEMONEY_BASE blank. Bots run inside this container, so on the main
# host this is the compose service name (http://voucher:8082) — NOT the host's
# 127.0.0.1:3611. On a separate VPS, point it at the main host's voucher over a private
# network (e.g. http://10.x.x.x:3611). Leave unset to require shops to set TRUEMONEY_BASE.
VOUCHER_BASE_URL=http://voucher:8082
