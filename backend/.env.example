# Supabase Database (Settings > Database > Connection string)
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.zozkagchtjmiidtsajcz
DB_PASSWORD=<supabase-database-password>
DB_POOL_MAX_SIZE=3
DB_POOL_MIN_IDLE=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_MAX_LIFETIME_MS=600000

# Supabase JWT Secret (Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_URL=https://<project-ref>.supabase.co

# CORS — frontend origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*

# Billing service (internal) — same token as services/billing-service/.env
BILLING_BASE_URL=http://localhost:8081
BILLING_SERVICE_TOKEN=<same-as-billing-service>

# SlipOK (slipok.com > branch > API key & branch id)
SLIPOK_BASE_URL=https://api.slipok.com
SLIPOK_BRANCH_ID=<your-branch-id>
SLIPOK_API_KEY=<your-api-key>

# PromptPay receiver id of the shop (mobile no. / national id / e-wallet id)
PROMPTPAY_ID=<shop-promptpay-id>

# Daily renewal/expiry automation. Keeps renewals and expired-seat release running.
# Set false only during a planned maintenance window.
RUNTIME_AUTOMATION_ENABLED=true

# Platform monitoring (/performance status dashboard). All optional — sensible
# defaults apply. APP_VERSION is shown in the public health payload. Set
# MONITORING_COLLECT_ENABLED=false to turn off the periodic probe/collector.
APP_VERSION=0.1.0
MONITORING_COLLECT_ENABLED=true
MONITORING_COLLECT_INTERVAL_MS=300000
MONITORING_PERSIST_ENABLED=false
MONITORING_INCIDENTS_ENABLED=false
MONITORING_DB_PROBE_ENABLED=false
# Leave blank to avoid probing hosted frontend from the backend.
MONITORING_FRONTEND_PROBE_URL=
